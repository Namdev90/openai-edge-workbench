index 0000000..d01c6b1
--- /dev/null
+++ b/source/maintenance.py
@@ -0,0 +1,78 @@
+"""Bounded maintenance selections. No commands or user-provided download URLs."""
+from __future__ import annotations
+import re
+
+RECIPE_SCHEMA = 'workbench-recipes/1'
+DEPENDENCIES = {
+    'codex': ('node',), 'javascript': ('node',), 'playwright': ('node',),
+    'python': ('uv',), 'python-packages': ('python',),
+    'documents': ('python-packages',), 'science': ('python-packages',),
+    'extensions': ('editor',), 'migrate': ('editor',),
+    'docs-mcp': ('codex',), 'live': ('codex',),
+}
+CONTROL_IDS = {'inventory', 'verify', 'report'}
+RUNTIME_IDS = {'node', 'codex', 'openai-cli', 'python', 'python-packages',
+               'documents', 'science', 'javascript', 'playwright', 'dotnet'}
+
+def request_plan(request, defaults, catalog_builder):
+    if not isinstance(request, dict): raise ValueError('Object required.')
+    structured = 'options' in request or any(k in request for k in ('components','cost_free','review_installers'))
+    if structured:
+        if set(request)-{'options','components','cost_free','review_installers'}: raise ValueError('Unknown maintenance field.')
+        options=request.get('options',{})
+    else: options=request
+    if not isinstance(options,dict) or set(options)-set(defaults) or any(type(v) is not bool for v in options.values()):
+        raise ValueError('Invalid option.')
+    options={**defaults,**options}
+    cost_free=request.get('cost_free',False) if structured else False
+    review=request.get('review_installers',False) if structured else False
+    if type(cost_free) is not bool or type(review) is not bool: raise ValueError('Maintenance controls must be booleans.')
+    # The selectable catalog includes all optional adapters; dependencies do not
+    # silently disappear because a broad pack checkbox is off.
+    catalog=catalog_builder({k:True for k in defaults})
+    by_id={item['id']:item for item in catalog}
+    explicit=request.get('components') if structured else None
+    if explicit is not None:
+        if not isinstance(explicit,list) or not explicit or len(explicit)>len(catalog): raise ValueError('Select at least one component.')
+        if any(not isinstance(k,str) or k not in by_id or k in CONTROL_IDS for k in explicit): raise ValueError('Unknown or non-selectable component.')
+        if len(set(explicit))!=len(explicit): raise ValueError('Duplicate component.')
+        selected=set(explicit)
+    else: selected={item['id'] for item in catalog_builder(options)}-CONTROL_IDS
+    if cost_free: selected.discard('live'); options['live']=False
+    requested=set(selected)
+    def include(key):
+        for dep in DEPENDENCIES.get(key,()):
+            if dep not in selected: selected.add(dep); include(dep)
+    for key in list(selected): include(key)
+    # Resolver pack scope must describe exactly what is selected, not unrelated
+    # broad packs. It still resolves core imports before activating Python.
+    options.update(toolkit='documents' in selected,science='science' in selected,
+                   browser='playwright' in selected or 'canary' in selected,
+                   dotnet='dotnet' in selected,migrate='migrate' in selected,
+                   docs_mcp='docs-mcp' in selected,live='live' in selected)
+    plan=[{**item,'selection_reason':('requested' if item['id'] in requested else 'required dependency' if item['id'] not in CONTROL_IDS else 'run bookkeeping')} for item in catalog if item['id'] in selected|CONTROL_IDS]
+    return {'options':options,'plan':plan,'requested':sorted(requested),
+            'selective':explicit is not None,'cost_free':cost_free,'review_installers':review}
+
+def impact(item, selected):
+    key=item['id']; wing=item['kind']=='winget'
+    runtime_report=key=='report' and bool(set(selected)&RUNTIME_IDS)
+    return {'network':wing or key in RUNTIME_IDS|{'extensions','migrate','docs-mcp','verify','live'},
+            'possible_uac_or_sign_in':wing, 'possible_restart':wing,
+            'configuration':key in {'inventory','migrate','docs-mcp'} or runtime_report,
+            'quota_or_billing':key=='live',
+            'interactive_checkpoint':wing,
+            'scope':('Selected Windows package; its installer may ask for approval/sign-in.' if wing else
+                     'Managed tool launchers and user PATH; no machine PATH edit.' if runtime_report else
+                     'User-selected read-only model request; existing authentication and billing apply.' if key=='live' else
+                     'Existing adapter boundaries apply; no automatic reboot or security-policy changes.')}
+
+def validate_recipe(value, defaults, builder):
+    if not isinstance(value,dict) or set(value)!={'name','request'}: raise ValueError('Recipe requires name and request.')
+    name=value['name']
+    if not isinstance(name,str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9 _-]{0,47}',name): raise ValueError('Use 1-48 letters, digits, spaces, underscores or hyphens for the recipe name.')
+    request=value['request']
+    if not isinstance(request,dict) or set(request)!={'options','components','cost_free','review_installers'}: raise ValueError('Recipe requires a complete maintenance request.')
+    normalized=request_plan(request,defaults,builder)
+    if not normalized['selective']: raise ValueError('Recipe must list selected components.')
+    return {'name':name,'request':request}
